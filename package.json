{
  "publisher": "rikka",
  "name": "folder-alias",
  "displayName": "%extension.displayName%",
  "version": "1.2.0",
  "packageManager": "pnpm@11.5.0",
  "description": "%extension.description%",
  "author": "Rikka",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Muromi-Rikka/folder-alias#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muromi-Rikka/folder-alias"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/folder-alias/issues"
  },
  "keywords": [
    "alias",
    "folder-alias",
    "file-alias",
    "explorer",
    "tooltip",
    "rename",
    "bookmark",
    "navigation"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "media/icons.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "folder-alias.configLocation": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "vscode",
            "root"
          ],
          "enumDescriptions": [
            "%configuration.configLocation.enum.auto%",
            "%configuration.configLocation.enum.vscode%",
            "%configuration.configLocation.enum.root%"
          ],
          "description": "%configuration.configLocation.description%"
        }
      }
    },
    "commands": [
      {
        "command": "folder-alias.addAlias",
        "title": "%command.addAlias%",
        "icon": {
          "light": "media/light/edit.svg",
          "dark": "media/dark/edit.svg"
        }
      },
      {
        "command": "folder-alias.deleteAlias",
        "title": "%command.deleteAlias%",
        "icon": {
          "light": "media/light/delete.svg",
          "dark": "media/dark/delete.svg"
        }
      },
      {
        "command": "folder-alias.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "folder-alias.applyPreset",
        "title": "%command.applyPreset%"
      },
      {
        "command": "folder-alias.saveAsPreset",
        "title": "%command.saveAsPreset%"
      },
      {
        "command": "folder-alias.deletePreset",
        "title": "%command.deletePreset%"
      },
      {
        "command": "folder-alias.searchAlias",
        "title": "%command.searchAlias%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "folder-alias.addAlias",
          "group": "1_modification"
        },
        {
          "command": "folder-alias.deleteAlias",
          "group": "1_modification"
        },
        {
          "command": "folder-alias.refresh",
          "group": "1_modification"
        },
        {
          "command": "folder-alias.applyPreset",
          "when": "explorerResourceIsFolder",
          "group": "1_modification"
        },
        {
          "command": "folder-alias.saveAsPreset",
          "when": "explorerResourceIsFolder",
          "group": "1_modification"
        },
        {
          "command": "folder-alias.deletePreset",
          "when": "explorerResourceIsFolder",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "folder-alias.deleteAlias",
          "when": "workspaceHasFolderAlias"
        },
        {
          "command": "folder-alias.refresh",
          "when": "workspaceHasFolderAlias"
        },
        {
          "command": "folder-alias.applyPreset"
        },
        {
          "command": "folder-alias.saveAsPreset"
        },
        {
          "command": "folder-alias.deletePreset"
        },
        {
          "command": "folder-alias.searchAlias",
          "when": "workspaceHasFolderAlias"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "dev": "pnpm build --watch --sourcemap",
    "prepare": "husky",
    "update:gen": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "vscode:prepublish": "pnpm run build",
    "publish": "vsce publish --no-dependencies",
    "pack": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "changelog": "changelogen --from \"$(git tag --sort=-version:refname | head -1)\"",
    "changelog:write": "changelogen --from \"$(git tag --sort=-version:refname | head -1)\" --output",
    "release": "bumpp && pnpm run publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^24.13.0",
    "@types/vscode": "^1.120.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vscode/vsce": "^3.9.2",
    "bumpp": "^11.1.0",
    "changelogen": "^0.6.2",
    "destr": "^2.0.5",
    "es-toolkit": "^1.47.0",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "pathe": "^2.0.3",
    "reactive-vscode": "^1.0.2",
    "taze": "^19.14.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vscode-ext-gen": "^1.6.0"
  }
}
