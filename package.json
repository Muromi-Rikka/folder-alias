{
  "publisher": "rikka",
  "name": "folder-alias",
  "displayName": "%extension.displayName%",
  "version": "0.1.3",
  "packageManager": "pnpm@11.5.0",
  "description": "%extension.description%",
  "author": "Rikka",
  "license": "GPLV3",
  "homepage": "https://github.com/Muromi-Rikka/folder-alias#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muromi-Rikka/folder-alias"
  },
  "bugs": {
    "url": "https://github.com/Muromi-Rikka/folder-alias/issues"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "media/icons.png",
  "files": [
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "dist/*",
    "l10n/*",
    "media/*"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {}
    },
    "commands": [
      {
        "command": "folder-alias.addAlias",
        "title": "%command.addAlias%",
        "icon": {
          "light": "media/light/edit.svg",
          "dark": "media/dark/edit.svg"
        }
      },
      {
        "command": "folder-alias.refresh",
        "title": "%command.refresh%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "folder-alias.addAlias",
          "group": "1_modification"
        },
        {
          "command": "folder-alias.refresh",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "folder-alias.refresh",
          "when": "workspaceHasFolderAlias"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "dev": "pnpm build --watch --sourcemap",
    "prepare": "pnpm update:gen",
    "update:gen": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "vscode:prepublish": "pnpm run build",
    "publish": "vsce publish --no-dependencies",
    "pack": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm run publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.0",
    "@types/vscode": "^1.120.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vscode/vsce": "^3.9.2",
    "bumpp": "^11.1.0",
    "destr": "^2.0.5",
    "eslint": "^10.4.1",
    "lodash-es": "^4.18.1",
    "pathe": "^2.0.3",
    "reactive-vscode": "^1.0.2",
    "taze": "^19.14.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vscode-ext-gen": "^1.6.0"
  }
}
